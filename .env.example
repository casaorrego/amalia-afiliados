# Portal de afiliadas de Amalia — variables de entorno.
# Copiar a .env.local para desarrollo; en producción van en Vercel.
# Guía completa: AMALIA-SETUP.md

# Supabase. El ?schema=refferq es OBLIGATORIO: mantiene las 28 tablas
# del portal aisladas de la base de pacientes (public).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=refferq&sslmode=require"

# Sesiones. Mínimo 32 caracteres — generar con: openssl rand -base64 32
JWT_SECRET=""

# Loops: el login manda un código de 6 dígitos por correo, así que sin
# esta llave NADIE puede entrar al portal. El transactional en Loops
# debe llamarse exactamente "afiliados_codigo_acceso".
LOOPS_API_KEY=""

NEXT_PUBLIC_APP_URL="https://afiliados.somosamalia.com"

# Opcional: quién recibe el aviso de referida nueva (separados por coma).
ADMIN_EMAILS=""
